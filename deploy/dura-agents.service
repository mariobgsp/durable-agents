# dura-agents as a user service.
#
#   cp deploy/dura-agents.service ~/.config/systemd/user/
#   systemctl --user daemon-reload
#   systemctl --user enable --now dura-agents
#   loginctl enable-linger "$USER"      # keep it running after logout, and across reboots
#
# Edit PI_ALLOWED_HOSTS before starting: it must contain the hostname your browser will use, or every
# /api request answers 403 "Host not allowed". See docs/tailscale.md.
[Unit]
Description=dura-agents server
Documentation=file://%h/Projects/mariobgsp/durable-agents/docs/tailscale.md
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=%h/Projects/mariobgsp/durable-agents

# Loopback only. TLS and the public name are handled by `tailscale serve`, never by this process.
Environment=PI_SERVER_PORT=8787
Environment=PI_HOST=127.0.0.1
# The name the phone will open. A leading dot matches every subdomain, so ".ts.net" allows the whole
# tailnet; prefer the exact MagicDNS name unless you move the app between machines.
Environment=PI_ALLOWED_HOSTS=.ts.net
# Small machines: keep the heap modest so a 4 GB box does not swap itself to death.
Environment=NODE_OPTIONS=--max-old-space-size=768

# Agent scratch space, inside the boundary. It defaults to ~/tmp/<id>, which ProtectHome=read-only below
# would refuse — and granting write access to all of ~/tmp to keep the default would defeat the point.
Environment=PI_AGENT_TMP_DIR=%h/Projects/mariobgsp/durable-agents/data/tmp

# The token is data/token (mode 600), created on first start and reused afterwards.
ExecStart=/usr/bin/env node packages/server/src/index.ts

Restart=always
RestartSec=3
# The server closes Fastify on SIGINT/SIGTERM; give it a moment before systemd escalates.
KillSignal=SIGTERM
TimeoutStopSec=20

# ---------- the boundary that the permission tiers are not ----------
#
# The tiers in the app decide which tools exist. These lines decide what a permitted tool can reach, which is
# the only thing that actually contains a wrong or hostile action: `pi` has no sandbox of its own, and
# neither does this process. Without them, "Standard" is a promise rather than a limit.
#
# The app reports which of the two is in force (`sandboxed` on /api/health, shown in the agent editor), so
# this flag is what turns the UI's wording from "policy only" into "enforced by systemd".
Environment=PI_SANDBOXED=1

# Read-only everywhere except the data directory. Keep ReadWritePaths in step with WorkingDirectory above.
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=%h/Projects/mariobgsp/durable-agents/data
# An agent whose cwd is outside the data directory cannot write there unless its root is listed too. Add one
# line per root you actually use, rather than opening the whole home directory:
# ReadWritePaths=%h/scratch

PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
RestrictSUIDSGID=yes
NoNewPrivileges=yes
# Outbound TCP for the model providers, and the loopback socket the UI talks to. Nothing else.
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6

[Install]
WantedBy=default.target
