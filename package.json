{
  "name": "durable-agents",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "engines": {
    "node": ">=22.19.0"
  },
  "scripts": {
    "start": "node packages/cli/bin/dura.ts start",
    "dev": "node packages/cli/bin/dura.ts start --watch",
    "check": "tsc -p tsconfig.json && node scripts/check-language.mjs",
    "lint:lang": "node scripts/check-language.mjs",
    "e2e": "node scripts/e2e/run.mjs",
    "e2e:real": "node scripts/e2e/run.mjs --real",
    "bench": "node scripts/bench/five-agents.mjs"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "typescript": "^7.0.2"
  }
}
