# Optional: used when there are no pi credentials in ~/.pi/agent/auth.json
OPENCODE_API_KEY=

# Local server port (default 8787)
PI_SERVER_PORT=8787

# Bind address. Keep 127.0.0.1 and put a TLS terminator in front (e.g. `tailscale serve`); the server
# itself speaks plain HTTP and must not be exposed directly.
PI_HOST=127.0.0.1

# Hosts accepted in the Host header, in addition to the always-allowed loopback names. Needed when a
# proxy forwards a real hostname, otherwise every /api route answers 403 "Host not allowed".
# Comma-separated; a leading dot matches every subdomain.
#   PI_ALLOWED_HOSTS=laptop.tail1a2b3c.ts.net
#   PI_ALLOWED_HOSTS=.ts.net
PI_ALLOWED_HOSTS=
