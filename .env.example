# The durable home. Defaults to ~/.dura-file.
DURA_HOME=

# Seed bots at init: label:token,label:token (a second colon in --token is treated as a label prefix).
# Prefer "dura bot add" so the token is stored 0600 and never sits in a shell profile.
DURA_TELEGRAM_BOTS=

# debug | info | warn | error. Info records lifecycle, connection, conversations and errors.
DURA_LOG_LEVEL=info

# Test-only: point the Bot API at a fake server. Never set in production.
# DURA_TELEGRAM_API_BASE=http://127.0.0.1:8081

# Provider keys are stored by the CLI in ~/.dura-file/credentials.json (0600). Environment variables remain
# the last credential layer, so an existing OPENCODE_API_KEY keeps working.
OPENCODE_API_KEY=
